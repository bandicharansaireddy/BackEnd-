{
  "info": {
    "name": "FreshMart API (catalog and auth endpoints)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Catalog and initial account/session endpoints currently implemented. Password reset and commerce endpoints remain future work."
  },
  "variable": [{"key": "baseUrl", "value": "http://localhost:8080"}, {"key": "accessToken", "value": ""}, {"key": "password", "value": ""}],
  "item": [
    {"name": "List products", "request": {"method": "GET", "url": "{{baseUrl}}/api/products?page=0&size=12&sort=name"}},
    {"name": "Search and filter products", "request": {"method": "GET", "url": "{{baseUrl}}/api/products?q=mango&category=fruit&minPrice=20&maxPrice=250&sort=price-asc"}},
    {"name": "Product details", "request": {"method": "GET", "url": "{{baseUrl}}/api/products/1"}},
    {"name": "Categories", "request": {"method": "GET", "url": "{{baseUrl}}/api/categories"}},
    {"name": "Category products", "request": {"method": "GET", "url": "{{baseUrl}}/api/categories/1/products?page=0&size=12"}},
    {"name": "Register", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"fullName\": \"Fresh Buyer\",\n  \"email\": \"buyer@example.com\",\n  \"mobile\": \"9876543210\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\"\n}"}, "url": "{{baseUrl}}/api/auth/register"}},
    {"name": "Login", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"identifier\": \"buyer@example.com\",\n  \"password\": \"{{password}}\"\n}"}, "url": "{{baseUrl}}/api/auth/login"}},
    {"name": "Refresh (browser Origin required)", "request": {"method": "POST", "header": [{"key": "Origin", "value": "http://localhost:5173"}], "url": "{{baseUrl}}/api/auth/refresh"}},
    {"name": "Logout (browser Origin required)", "request": {"method": "POST", "header": [{"key": "Origin", "value": "http://localhost:5173"}], "url": "{{baseUrl}}/api/auth/logout"}},
    {"name": "Current user", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": "{{baseUrl}}/api/auth/me"}}
  ]
}
